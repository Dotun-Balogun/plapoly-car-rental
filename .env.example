# ---- Supabase (Dashboard -> Project Settings -> API Keys) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "publishable" key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- Your public site address (used in email confirmation links) ----
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Business details shown to customers ----
NEXT_PUBLIC_APP_NAME= Pl
NEXT_PUBLIC_SUPPORT_PHONE=+2348000000000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com

# ---- Where customers send payment (bank transfer / USSD) ----
NEXT_PUBLIC_BANK_NAME=Plapoly
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0123456789
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Your Business Name Ltd
